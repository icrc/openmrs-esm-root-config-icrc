{
  "name": "@icrc/esm-icrc-overrides-app",
  "version": "1.1.0",
  "description": "A javascript module for setting up and configuring your SPA ",
  "license": "BSD-3-Clause",
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/openmrs-esm-icrc-overrides.js",
  "scripts": {
    "clean": "rimraf dist",
    "start": "webpack-dev-server",
    "lint": "eslint src",
    "build": "npm run clean && webpack --mode production && webpack",
    "prepublishOnly": "npm run build"
  },
  "browserslist": [
    "extends browserslist-config-openmrs"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged && npm run lint"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icrc/openmrs-esm-root-config-icrc.git"
  },
  "bugs": {
    "url": "https://github.com/icrc/openmrs-esm-root-config-icrc/issues"
  },
  "homepage": "https://github.com/icrc/openmrs-esm-root-config-icrc#readme",
  "devDependencies": {
    "clean-webpack-plugin": "^3.0.0",
    "eslint": "^10.10.0",
    "eslint-config-important-stuff": "^1.1.0",
    "eslint-config-prettier": "^6.3.0",
    "eslint-plugin-prettier": "^3.1.0",
    "husky": "^4.2.5",
    "prettier": "^1.18.2",
    "pretty-quick": "^4.2.2",
    "rimraf": "^3.0.0",
    "systemjs-webpack-interop": "^1.1.0",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^5.2.6"
  },
  "dependencies": {
    "@openmrs/esm-module-config": "^1.2.0"
  }
}
